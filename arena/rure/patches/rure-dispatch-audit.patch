--- a/Cargo.toml
+++ b/Cargo.toml
@@ -59,0 +60,6 @@
+
+[dependencies.memchr]
+version = "=2.8.3"
+
+[patch.crates-io]
+memchr = { path = "../memchr-source" }
--- a/src/rure.rs
+++ b/src/rure.rs
@@ -20,0 +21,54 @@
+
+// These private arena entry points reset and read the patched memchr audit in
+// the same native call. Keeping the thread-local operations together matters:
+// a Go caller may return on a different OS thread between separate cgo calls.
+ffi_fn! {
+    fn rure_casei_find(
+        re: *const Regex,
+        haystack: *const u8,
+        len: size_t,
+        start: size_t,
+        match_info: *mut rure_match,
+        dispatch_bits: *mut u32,
+    ) -> bool {
+        memchr::casei_dispatch_reset();
+        let re = unsafe { &*re };
+        let haystack = unsafe { slice::from_raw_parts(haystack, len) };
+        let matched = re.find_at(haystack, start).map(|m| unsafe {
+            if !match_info.is_null() {
+                (*match_info).start = m.start();
+                (*match_info).end = m.end();
+            }
+        }).is_some();
+        unsafe {
+            if !dispatch_bits.is_null() {
+                *dispatch_bits = u32::from(memchr::casei_dispatch_bits());
+            }
+        }
+        matched
+    }
+}
+
+ffi_fn! {
+    fn rure_casei_find_captures(
+        re: *const Regex,
+        haystack: *const u8,
+        len: size_t,
+        start: size_t,
+        captures: *mut Captures,
+        dispatch_bits: *mut u32,
+    ) -> bool {
+        memchr::casei_dispatch_reset();
+        let re = unsafe { &*re };
+        let haystack = unsafe { slice::from_raw_parts(haystack, len) };
+        let slots = unsafe { &mut (*captures).0 };
+        let matched = re.captures_read_at(slots, haystack, start).is_some();
+        unsafe {
+            if !dispatch_bits.is_null() {
+                *dispatch_bits = u32::from(memchr::casei_dispatch_bits());
+            }
+        }
+        matched
+    }
+}
+
